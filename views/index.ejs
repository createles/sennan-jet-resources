<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: typeof title != 'undefined' ? title : 'Welcome to Sennan JETs' }) %>
<body>
    <%- include('partials/header') %>

    <section class="hero-banner">
        <div class="slide active" style="background-image: url('/images/chokeji.jpeg');"></div>
        <div class="slide" style="background-image: url('/images/longpark.png');"></div>
        <div class="slide" style="background-image: url('/images/rinshoji.jpg');"></div>
        <div class="slide" style="background-image: url('/images/sennan-fireworks.jpg');"></div>
        
        <div class="hero-content">
            <h1>Welcome to Sennan City JETs!</h1>
            <p>Your local resource for everything Sennan and JET.</p>
        </div>
    </section>

    <div class="container">
        <section class="preview-section section-target" data-theme="#F4D35E">
            <div class="section-header">
                <h2>Marketplace Highlights</h2>
                <a href="/listings" class="view-all">View All &rarr;</a>
            </div>
            <p style="color: var(--text-secondary); margin-bottom: 2rem; text-align: center; font-style: italic;"> From furniture, appliances, and even bicycles, find what you need or list items looking for a new home!</p>

            <div class="vertical-preview-container">
                <% if (typeof items != 'undefined' && items.length > 0) { %>
                    <% items.forEach(item => { %>
                        <a href="/listings" class="item-card-horizontal">
                            <% if (item.images && item.images.length > 0) { %>
                                <img src="<%= item.images[0] %>" alt="<%= item.title %>">
                            <% } else { %>
                                <div class="fallback-img"></div>
                            <% } %>
                            <div class="card-body">
                                <span style="color: var(--accent); font-size: 0.75rem; text-transform: uppercase; font-weight: 700; margin-bottom: 0.5rem;"><%= item.category %></span>
                                <h3 style="font-size: 1.5rem; margin-bottom: 0.5rem;"><%= item.title %></h3>
                                <% if (item.notes) { %>
                                    <small style="color: var(--text-secondary); font-size: 0.85em; margin-bottom: 0.5rem; display: block;"><%= item.notes %></small>
                                <% } %>
                                <div style="margin-bottom: 1rem;">
                                    <p class="item-desc" style="font-size: 0.95rem; color: var(--text-secondary); display: -webkit-box; -webkit-line-clamp: 1; line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; margin: 0; word-break: break-word;"><%= item.description %></p>
                                </div>
                                <div style="color: var(--text-primary); font-weight: 700; font-size: 1.25rem; margin-top: auto;">
                                    ¥<%= item.price.toLocaleString() %>
                                    <% if (item.originalPrice) { %>
                                        <small style="text-decoration: line-through; margin-left: 0.5rem; font-weight: normal; font-size: 0.8rem; color: var(--text-secondary);">
                                            ¥<%= item.originalPrice.toLocaleString() %>
                                        </small>
                                    <% } %>
                                </div>
                                
                                <!-- Seller Display inside preview panel -->
                                <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 0.75rem; border-top: 1px solid var(--border-color); padding-top: 0.75rem;">
                                    Seller: <%= item.user ? item.user.name : 'Unknown' %>
                                </div>
                            </div>
                        </a>
                    <% }) %>
                <% } else { %>
                    <div class="glass-panel" style="padding: 3rem; text-align: center; border: 1px dashed var(--border-color);">
                        <p style="color: var(--text-secondary); font-style: italic;">The collection is currently empty. Check back soon.</p>
                    </div>
                <% } %>
            </div>
        </section>
        <p style="color: var(--text-secondary); margin-bottom: 2rem; text-align: center; font-style: italic;">Want to list your own items? <a href="/auth/login">Log in</a> to get started.</p>

        <section class="guide-section section-target" data-theme="#F48498">
            <div class="section-header">
                <h2>Local Guides & Vibe</h2>
            </div>
            
            <p class="view-all" style="text-align: center; margin-bottom: 1rem; display: block;">Curated Instagram Feeds</p>
            
            <div style="width: 100%; overflow: hidden; box-sizing: border-box; border-radius: 8px;">
                <script src="https://elfsightcdn.com/platform.js" async></script>
                <div class="elfsight-app-f38add33-8906-49b0-adfa-86302258a886" data-elfsight-app-lazy></div>
            </div>
        </section>

        <section class="community-section section-target" data-theme="#88D49E">
            <div class="section-header">
                <h2>Community Resources</h2>
            </div>
            <h3 style="text-align: center;">Your Go-To Guide for Thriving in Sennan</h3>
            
            <div class="community-grid">
                
                <div style="display: flex; flex-direction: column; align-items: center;">
                    <div class="pamphlet-wrapper">
                        <iframe loading="lazy" src="https://www.canva.com/design/DAGrzm5vBg8/YsOapJg3baFVjBfF1chthw/view?embed" allowfullscreen="allowfullscreen" allow="fullscreen"></iframe>
                    </div>
                    <h5 style="margin-top: 1.5rem; color: var(--text-secondary); font-style: italic; text-align: center;"> 
                        Sennan JET Infobook by Stephanie Beatrice Eseteves
                    </h5>
                </div>

                <div class="glass-panel" style="padding: 2.5rem; height: fit-content; box-sizing: border-box; width: 100%;">
                    <h3 style="margin-bottom: 2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;">Helpful Links</h3>
                    
                    <h4 style="margin-top: 1.5rem; color: var(--text-primary);">JET Materials</h4>
                    <ul style="margin-top: 1rem; color: var(--text-secondary); list-style: square; padding-left: 1.5rem;">
                        <li style="margin-bottom: 0.5rem;"><a href="https://jetprogramme.org/en/download/" style="color: var(--accent); text-decoration: none; font-weight: 500;">JET Program Handbook</a></li>
                        <li><a href="https://www.altopedia.net/" style="color: var(--accent); text-decoration: none; font-weight: 500;">Altopedia Shared Resources</a></li>
                    </ul>

                    <h4 style="margin-top: 2rem; color: var(--text-primary);">Monthly Kyuushoku Menu</h4>
                    <ul style="margin-top: 1rem; color: var(--text-secondary); list-style: square; padding-left: 1.5rem;">
                        <li style="margin-bottom: 0.5rem;"><a href="https://www.city.sennan.lg.jp/kakuka/kyouiku/kyouiku_soumu/kyushoku/about/7349.html#:~:text=%E6%94%AF%E6%8F%B4%E8%A3%9C%E5%8A%A9%E9%87%91%E3%81%AB%E3%81%A4%E3%81%84%E3%81%A6-,%E7%8C%AE%E7%AB%8B,-%E3%83%BB%E3%82%A2%E3%83%AC%E3%83%AB%E3%82%AE%E3%83%BC%E8%A1%A8" style="color: var(--accent); text-decoration: none; font-weight: 500;">Elementary School Menu</a></li>
                        <li><a href="https://www.city.sennan.lg.jp/kakuka/kyouiku/kyouiku_soumu/kyushoku/about/7384.html#:~:text=PDF%E3%83%95%E3%82%A1%E3%82%A4%E3%83%AB%3A%20346.7KB)-,%E7%8C%AE%E7%AB%8B,-%E5%86%99%E7%9C%9F%EF%BC%88%E4%B8%AD%E5%AD%A6%E6%A0%A1%EF%BC%89" style="color: var(--accent); text-decoration: none; font-weight: 500;">Middle School Menu</a></li>
                    </ul>

                    <h4 style="margin-top: 2rem; color: var(--text-primary);">City Garbage Collection</h4>
                    <ul style="margin-top: 1rem; color: var(--text-secondary); list-style: square; padding-left: 1.5rem;">
                        <li style="margin-bottom: 0.5rem;"><a href="https://www.city.sennan.lg.jp/kakuka/shiminseikatu/seiso/gomishushu/1455595440966.html#:~:text=%E8%AA%9E/Espanol/Portuguese-,English,-%EF%BC%88%E8%8B%B1%E8%AA%9E%EF%BC%89" style="color: var(--accent); text-decoration: none; font-weight: 500;">Monthly Garbage Collection Schedule</a></li>
                        <li><a href="https://www.city.sennan.lg.jp/material/files/group/13/74405378.pdf" style="color: var(--accent); text-decoration: none; font-weight: 500; font-style: italic;">How to separate and dispose of waste</a></li>
                    </ul>

                    <h4 style="margin-top: 2rem; color: var(--text-primary);">Sennan Events</h4>
                    <a href="https://welcome-sennan.com/events" target="_blank" class="btn-primary" style="margin-top: 1rem; display: block; text-align: center;">View City Calendar</a>
                </div>
            </div>
        </section>

        <section class="board-section section-target" data-theme="#A78BFA" style="max-width: 800px; margin: 4rem auto; padding: 0 1rem;">
            <div class="section-header">
                <h2>Community Board</h2>
            </div>
        
            <% if (locals.user) { %>
                <div class="glass-panel" style="padding: 1.5rem; margin-bottom: 2rem;">
                    <form id="newPostForm" style="display: flex; gap: 1rem; align-items: flex-start;">
                        <textarea id="postContent" required placeholder="Share an announcement..."
                            style="flex: 1; padding: 1rem; border: 1px solid var(--border-color); border-radius: 8px; resize: none; background: rgba(255,255,255,0.8);"></textarea>
                        <button type="submit" class="view-all"
                            style="background: var(--text-primary); color: white; padding: 0.8rem 1.5rem; border: none; border-radius: 6px; font-weight: 700; cursor: pointer;">Post</button>
                    </form>
                </div>
            <% } else { %>
                <div class="glass-panel" style="padding: 1.5rem; text-align: center; margin-bottom: 2rem;">
                    <p style="margin: 0; color: var(--text-secondary);">Please <a href="/login" style="color: var(--accent); font-weight: 700; text-decoration: none;">Log In</a> to drop announcements.</p>
                </div>
            <% } %>
        
            <div id="boardFeed" style="display: flex; flex-direction: column; gap: 1.5rem; max-height: 600px; overflow-y: auto; padding-right: 0.5rem;">
                <!-- Posts injected here via JS -->
            </div>
        
            <div style="text-align: center; margin-top: 2rem;">
                <button id="loadMoreBtn" class="view-all"
                    style="display: none; background: transparent; color: var(--text-primary); border: 2px solid var(--text-primary); padding: 0.6rem 2rem; border-radius: 6px; cursor: pointer; font-weight: 700;">Load More</button>
            </div>
        </section>

    </div>

    <%- include('partials/footer') %>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const slides = document.querySelectorAll('.slide');
            let currentSlide = 0;
            setInterval(() => {
                slides[currentSlide].classList.remove('active');
                currentSlide = (currentSlide + 1) % slides.length;
                slides[currentSlide].classList.add('active');
            }, 5000); 

            // Dynamic Accent Color scroll spy
            const root = document.documentElement;
            const sections = document.querySelectorAll('.section-target');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const newColor = entry.target.getAttribute('data-theme');
                        if(newColor) root.style.setProperty('--accent', newColor);
                    }
                });
            }, { root: null, rootMargin: '0px', threshold: 0.35 });
            sections.forEach(section => observer.observe(section));
        });

        // Message Board Script
            let skip = 0;
            const take = 3;
            let currentUserId = null;
            const boardFeed = document.getElementById('boardFeed');
            const loadMoreBtn = document.getElementById('loadMoreBtn');
            const newPostForm = document.getElementById('newPostForm');

            // Initialization
            document.addEventListener('DOMContentLoaded', () => {
                fetchPosts();
            });

            // Fetch Posts API Call
            async function fetchPosts() {
                try {
                    const res = await fetch(`/board/api/posts?skip=${skip}&take=${take}`);
                    const data = await res.json();
                    currentUserId = data.currentUserId;

                    // Fallback for empty board state
                    if (data.posts.length === 0 && skip === 0) {
                        boardFeed.innerHTML = `
                            <div class="glass-panel" style="padding: 3rem; text-align: center; border: 1px dashed var(--border-color);">
                                <p style="color: var(--text-secondary); margin: 0; font-style: italic;">No announcements posted yet. Be the first!</p>
                            </div>
                        `;
                        if (loadMoreBtn) loadMoreBtn.style.display = 'none';
                        return;
                    }

                    data.posts.forEach(post => {
                        boardFeed.insertAdjacentHTML('beforeend', generatePostHTML(post));
                    });

                    skip += data.posts.length;

                    if (data.posts.length < take) {
                        if (loadMoreBtn) loadMoreBtn.style.display = 'none';
                    } else {
                        if (loadMoreBtn) loadMoreBtn.style.display = 'inline-block';
                    }
                } catch (err) {
                    console.error('Error fetching posts:', err);
                }
            }

            // Generate HTML for a Post
            function generatePostHTML(post) {
                const dateStr = new Date(post.createdAt).toLocaleDateString();
                
                let latestCommentHTML = '';
                let olderCommentsHTML = '';
                
                if (post.comments.length > 0) {
                    const latest = post.comments[0];
                    latestCommentHTML = `
                      <div style="font-size: 0.85rem; padding-bottom: 0.5rem;">
                        <strong>${latest.user.name}:</strong> <span style="color: var(--text-secondary);">${latest.content}</span>
                      </div>
                    `;
                    
                    const older = post.comments.slice(1);
                    if (older.length > 0) {
                        olderCommentsHTML = older.map(c => `
                          <div style="font-size: 0.85rem; padding-bottom: 0.5rem;">
                            <strong>${c.user.name}:</strong> <span style="color: var(--text-secondary);">${c.content}</span>
                          </div>
                        `).join('');
                    }
                }

                const commentFormHTML = currentUserId ? `
      <form onsubmit="submitComment(event, '${post.id}')" style="display: flex; gap: 0.5rem; margin-top: 0.5rem;">
        <input type="text" name="content" required placeholder="Write a comment..." style="flex: 1; padding: 0.5rem; border: 1px solid var(--border-color); border-radius: 4px; font-size: 0.85rem;">
        <button type="submit" style="background: var(--text-primary); color: white; border: none; border-radius: 4px; padding: 0 1rem; font-weight: 700; cursor: pointer; font-size: 0.8rem;">Reply</button>
      </form>
    ` : '<p style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 0.5rem;">Log in to comment.</p>';

                return `
      <div class="glass-panel" id="post-${post.id}" style="padding: 1.5rem; position: relative;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; margin-bottom: 1rem;">
          <div>
            <h4 style="margin: 0; font-family: var(--font-header);">${post.user.name}</h4>
            <span style="font-size: 0.75rem; color: var(--text-secondary);">${dateStr}</span>
          </div>
          ${currentUserId === post.userId ? `
            <button onclick="deletePost('${post.id}')" style="background: transparent; border: none; color: #EF4444; font-size: 0.75rem; font-weight: 700; cursor: pointer; text-transform: uppercase;">Delete</button>
          ` : ''}
        </div>
        <p style="margin: 0 0 1rem 0; font-size: 0.95rem; line-height: 1.5; white-space: pre-wrap;">${post.content}</p>
        
        <div id="older-comments-wrapper-${post.id}" style="display: ${post.comments.length > 1 ? 'block' : 'none'}; margin-bottom: 0.5rem;">
            <button onclick="toggleComments('${post.id}')" style="background: none; border: none; color: var(--accent); font-weight: 700; cursor: pointer; font-size: 0.85rem; padding: 0; display: flex; align-items: center; gap: 0.3rem;">
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
              View previous comments (<span id="count-${post.id}">${Math.max(0, post.comments.length - 1)}</span>)
            </button>
            <div id="older-comments-${post.id}" style="display: none; flex-direction: column; gap: 0.5rem; margin-top: 0.5rem; padding: 1rem; background: rgba(255,255,255,0.4); border-radius: 6px;">
              ${olderCommentsHTML}
            </div>
        </div>
        
        <div id="latest-comment-${post.id}">
          ${latestCommentHTML}
        </div>

        ${commentFormHTML}
      </div>
    `;
            }

            // Event Listeners
            if (loadMoreBtn) loadMoreBtn.addEventListener('click', fetchPosts);

            if (newPostForm) {
                newPostForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const contentInput = document.getElementById('postContent');
                    try {
                        const res = await fetch('/board/api/post', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ content: contentInput.value })
                        });
                        const newPost = await res.json();
                        
                        // Remove empty state fallback if it exists before appending
                        const fallbackMsg = boardFeed.querySelector('.glass-panel p');
                        if (fallbackMsg && fallbackMsg.innerText.includes('No announcements')) {
                            boardFeed.innerHTML = '';
                        }

                        boardFeed.insertAdjacentHTML('afterbegin', generatePostHTML(newPost));
                        contentInput.value = '';
                        skip++; // Offset adjustment
                    } catch (err) {
                        console.error(err);
                    }
                });
            }

            // Interactions
            window.toggleComments = function (postId) {
                const list = document.getElementById(`older-comments-${postId}`);
                if (list.style.display === 'none') {
                    list.style.display = 'flex';
                } else {
                    list.style.display = 'none';
                }
            };

            window.submitComment = async function (e, postId) {
                e.preventDefault();
                const input = e.target.querySelector('input[name="content"]');
                try {
                    const res = await fetch(`/board/api/post/${postId}/comment`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ content: input.value })
                    });
                    const newComment = await res.json();

                    const latestContainer = document.getElementById(`latest-comment-${postId}`);
                    const olderList = document.getElementById(`older-comments-${postId}`);
                    const wrapper = document.getElementById(`older-comments-wrapper-${postId}`);
                    const countSpan = document.getElementById(`count-${postId}`);

                    if (latestContainer.firstElementChild) {
                        olderList.insertAdjacentHTML('afterbegin', latestContainer.innerHTML);
                        wrapper.style.display = 'block';
                        if (countSpan) countSpan.innerText = parseInt(countSpan.innerText || 0) + 1;
                    }

                    latestContainer.innerHTML = `
                        <div style="font-size: 0.85rem; padding-bottom: 0.5rem;">
                            <strong>${newComment.user.name}:</strong> <span style="color: var(--text-secondary);">${newComment.content}</span>
                        </div>
                    `;

                    input.value = '';
                } catch (err) {
                    console.error(err);
                }
            };

            window.deletePost = async function (postId) {
                if (!confirm('Delete this announcement?')) return;

                try {
                    const res = await fetch(`/board/api/post/${postId}`, {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' }
                    });

                    const result = await res.json();

                    if (res.ok) {
                        // Instantly drop the element from the feed
                        const postElement = document.getElementById(`post-${postId}`);
                        if (postElement) postElement.remove();
                        skip--; // Adjust offset backwards on deletion

                        // Inject empty state if feed is completely clear
                        if (boardFeed.children.length === 0) {
                            boardFeed.innerHTML = `
                                <div class="glass-panel" style="padding: 3rem; text-align: center; border: 1px dashed var(--border-color);">
                                    <p style="color: var(--text-secondary); margin: 0; font-style: italic;">No announcements posted yet. Be the first!</p>
                                </div>
                            `;
                        }
                    } else {
                        console.error(result.error);
                        alert(result.error || 'Failed to delete post.');
                    }
                } catch (err) {
                    console.error(err);
                }
            };
    </script>
</body>
</html>
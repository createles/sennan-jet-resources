<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'My Dashboard | Sennan JETs' }) %>
<style>
    /* Widened layout to give the split columns breathing room */
    .dashboard-container { 
        max-width: 1400px; 
        margin: 3rem auto; 
        padding: 0 2rem; 
        flex: 1; 
        position: relative; 
        z-index: 2; 
        box-sizing: border-box; 
        width: 100%;
    }

    /* Split column layout architecture */
    .dashboard-split-layout {
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    .dashboard-sidebar-panel {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .dashboard-main-panel {
        flex: 1;
    }

    /* Sticky control panel for screens wider than 1024px */
    @media (min-width: 1024px) {
        .dashboard-split-layout {
            display: grid;
            grid-template-columns: 420px 1fr;
            gap: 4rem;
            align-items: start;
        }

        .dashboard-sidebar-panel {
            position: sticky;
            top: 110px; /* Aligns neatly below the sticky header */
            max-height: calc(100vh - 150px);
            overflow-y: auto;
            padding-right: 0.5rem;
        }
        
        /* Hide scrollbars inside sticky sidebar for clean look */
        .dashboard-sidebar-panel::-webkit-scrollbar {
            display: none;
        }
        .dashboard-sidebar-panel {
            scrollbar-width: none;
        }
    }

    /* Common Form Styling */
    .form-group { width: 100%; margin-bottom: 1.5rem; }
    .form-group label { display: block; font-weight: 700; font-size: 0.85rem; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 0.5rem; }
    .form-group input, .form-group textarea, .form-group select { width: 100%; padding: 12px; border: 1px solid var(--border-color); border-radius: 4px; font-family: var(--font-body); background: rgba(255,255,255,0.8); box-sizing: border-box;}
    .form-group input:focus, .form-group textarea:focus, .form-group select:focus { outline: none; border-color: var(--accent); }

    /* Responsive Posting Grid */
    .grid { 
        display: grid; 
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); 
        gap: 2rem; 
        width: 100%;
        box-sizing: border-box;
    }
    
    /* Listing Cards */
    .card { overflow: hidden; display: flex; flex-direction: column; transition: transform 0.3s ease-out, border-color 0.3s ease-out, box-shadow 0.3s ease-out; padding: 0; box-sizing: border-box; max-width: 100%; width: 100%;}
    .card:hover { transform: translateY(-5px); border-color: var(--accent); box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
    .card img { width: 100%; height: 200px; object-fit: cover; border-bottom: 1px solid var(--border-color); }

    .card .fallback-img {
        width: 100%; min-width: 100%; height: 200px;
        border-radius: 4px 4px 0 0;
        border-right: none;
        border-bottom: 1px solid var(--border-color);
    }

    .card-content { padding: 1.5rem; display: flex; flex-direction: column; flex: 1; box-sizing: border-box; overflow: hidden;}
    .card-content h4, .card-content p { overflow-wrap: break-word; word-wrap: break-word;}

    .dashboard-btn { padding: 8px 12px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; border-radius: 4px; border: none; cursor: pointer; transition: background 0.3s; color: white; font-family: var(--font-body);}
    
    @media (max-width: 768px) {
        .grid { grid-template-columns: minmax(0, 1fr); max-width: 450px; margin: 0 auto; justify-items: center; }
        .dashboard-container { padding: 0 1rem; }
    }
</style>
<body>
    <%- include('partials/header') %>
    
    <div class="dashboard-container">
        
        <div class="dashboard-split-layout">
            
            <!-- Left Panel (Headers & Form creation card) -->
            <div class="dashboard-sidebar-panel">
                <div style="border-bottom: 1px solid var(--border-color); padding-bottom: 1.5rem;">
                    <h1 style="font-size: 2.5rem; font-weight: 400; line-height: 1.1; color: var(--text-primary);">Member Dashboard</h1>
                    <p style="color: var(--text-secondary); margin-top: 0.5rem; font-size: 1.05rem;">Manage your active local listings.</p>
                </div>

                <div class="glass-panel" style="padding: 2.2rem; box-sizing: border-box; width: 100%;">
                    <h3 style="margin-bottom: 1.5rem; font-size: 1.3rem;">Create New Listing</h3>
                    <form action="/dashboard/item" method="POST" enctype="multipart/form-data">
                        <div class="form-group">
                            <label>Item Title</label>
                            <input type="text" name="title" required>
                        </div>
                        <div class="form-group">
                            <label>Description</label>
                            <textarea name="description" rows="3" required></textarea>
                        </div>
                        <div class="form-group">
                            <label>Contact Via (e.g. FB Messenger, Line)</label>
                            <input type="text" name="contactInfo" placeholder="How buyers can reach you...">
                        </div>
                        <div style="display:flex; gap:1.2rem; flex-wrap: wrap;">
                            <div class="form-group" style="flex:1; min-width: 140px; margin-bottom: 0;">
                                <label>Price (¥)</label>
                                <input type="number" name="price" required>
                            </div>
                            <div class="form-group" style="flex:1; min-width: 140px; margin-bottom: 0;">
                                <label>Category</label>
                                <select name="category">
                                    <option value="KITCHEN">Kitchen</option>
                                    <option value="FURNITURE">Furniture</option>
                                    <option value="APPLIANCES">Appliances</option>
                                    <option value="CLOTHING">Clothing</option>
                                    <option value="BOOKS">Books</option>
                                    <option value="OTHERS">Others</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group" style="margin-top: 1.5rem;">
                            <label>Upload Image</label>
                            <input type="file" name="image" accept="image/*" required style="padding: 8px;">
                        </div>
                        <button type="submit" class="btn-primary" style="width: 100%; padding: 12px;">Publish Listing</button>
                    </form>
                </div>
            </div>

            <!-- Right Panel (Active Listings display grid) -->
            <div class="dashboard-main-panel">
                <h3 style="margin-bottom: 1.8rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.75rem; font-size: 1.5rem;">My Active Postings</h3>
                
                <div class="grid">
                    <% if (typeof items != 'undefined' && items.length > 0) { %>
                        <% items.forEach(item => { %>
                        <div class="card glass-panel" data-item="<%= encodeURIComponent(JSON.stringify(item)) %>">
                            <% if (item.images && item.images.length > 0) { %>
                                <img src="<%= item.images[0] %>" alt="<%= item.title %>">
                            <% } else { %>
                                <div class="fallback-img"></div>
                            <% } %>
                            <div class="card-content">
                                <span style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; margin-bottom: 0.5rem; color: <%= item.status === 'AVAILABLE' ? 'var(--accent-success)' : 'var(--accent)' %>">
                                    <%= item.status === 'AVAILABLE' ? item.status : 'RESERVED - ' + (item.reserveeName || 'Unknown') %>
                                </span>
                                <h4 style="font-size: 1.3rem; margin-bottom: 0.5rem; color: var(--text-primary);"><%= item.title %></h4>
                                <div style="font-weight: 700; font-size: 1.1rem; color: var(--text-secondary);">¥<%= item.price.toLocaleString() %></div>

                                <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 0.75rem; border-top: 1px solid var(--border-color); padding-top: 0.75rem; margin-bottom: 1.5rem;">
                                    Seller: You
                                </div>

                                <div style="margin-top: auto; display:flex; gap:0.5rem; border-top: 1px solid var(--border-color); padding-top: 1rem;">
                                    <% if (item.status === 'RESERVED') { %>
                                        <form action="/dashboard/item/<%= item.id %>/clear" method="POST" style="margin: 0; flex: 1;">
                                            <button type="submit" class="dashboard-btn" style="background: var(--text-secondary); width: 100%;">Clear</button>
                                        </form>
                                    <% } %>
                                    <% if (item.status !== 'SOLD') { %>
                                        <button type="button" class="dashboard-btn" style="background: var(--text-primary); flex: 1;" onclick="openEditModal(this.closest('.card'))">Edit</button>
                                        <form action="/dashboard/item/<%= item.id %>/sold" method="POST" style="margin: 0; flex: 1;">
                                            <button type="submit" class="dashboard-btn" style="background: var(--accent); width: 100%;">Mark Sold</button>
                                        </form>
                                    <% } else { %>
                                        <form action="/dashboard/item/<%= item.id %>/unsold" method="POST" style="margin: 0; width: 100%;">
                                            <button type="submit" class="dashboard-btn" style="background: #A0AEC0; width: 100%;">Mark Unsold</button>
                                        </form>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                    <% } else { %>
                        <div class="glass-panel" style="grid-column: 1 / -1; padding: 4rem; text-align: center; border: 1px dashed var(--border-color); width: 100%; box-sizing: border-box;">
                            <p style="color: var(--text-secondary); font-style: italic;">You haven't posted any items yet.</p>
                        </div>
                    <% } %>
                </div>
            </div>

        </div>
    </div>

    <!-- Edit Modal Overlay -->
    <div id="editModal" style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); justify-content: center; align-items: center; backdrop-filter: blur(5px);">
        <div class="glass-panel" style="width: 90vw; max-width: 500px; max-height: 90vh; overflow-y: auto; overflow-x: hidden; position: relative; padding: 2.5rem; background: rgba(255,255,255,0.95); box-sizing: border-box;">
            <span onclick="document.getElementById('editModal').style.display='none'" style="position: absolute; top: 15px; right: 20px; font-size: 1.5rem; cursor: pointer; color: var(--text-secondary);">&times;</span>
            <h3 style="margin-bottom: 1.5rem; color: var(--text-primary);">Edit Listing</h3>
            
            <form id="editForm" method="POST" action="" enctype="multipart/form-data">
                <div class="form-group">
                    <label>Item Title</label>
                    <input type="text" name="title" id="editTitle" required>
                </div>
                
                <div class="form-group">
                    <label>Description</label>
                    <textarea name="description" id="editDescription" rows="3" required></textarea>
                </div>
                
                <div class="form-group">
                    <label>Contact Via (How should buyers reach you?)</label>
                    <input type="text" name="contactInfo" id="editContactInfo" placeholder="e.g. LINE ID, FB Messenger...">
                </div>
                
                <div class="form-group">
                    <label>Manage Existing Images</label>
                    <div id="editImageContainer" style="display: flex; gap: 10px; overflow-x: auto; padding-bottom: 5px;"></div>
                </div>
                
                <div class="form-group">
                    <label>Upload Additional Images (Optional)</label>
                    <input type="file" name="newImages" accept="image/*" multiple style="padding: 8px;">
                </div>

                <div style="display:flex; gap:1rem; flex-wrap: wrap;">
                    <div class="form-group" style="flex:1; min-width: 150px;">
                        <label>Price (¥)</label>
                        <input type="number" name="price" id="editPrice" required>
                    </div>
                    <div class="form-group" style="flex:1; min-width: 150px;">
                        <label>Category</label>
                        <select name="category" id="editCategory">
                            <option value="KITCHEN">Kitchen</option>
                            <option value="FURNITURE">Furniture</option>
                            <option value="APPLIANCES">Appliances</option>
                            <option value="CLOTHING">Clothing</option>
                            <option value="BOOKS">Books</option>
                            <option value="OTHERS">Others</option>
                        </select>
                    </div>
                </div>
                
                <button type="submit" class="btn-primary" style="width: 100%;">Save Changes</button>
            </form>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script>
        function openEditModal(cardElement) {
            const itemData = JSON.parse(decodeURIComponent(cardElement.getAttribute('data-item')));
            
            // Standard Fields
            document.getElementById('editTitle').value = itemData.title;
            document.getElementById('editDescription').value = itemData.description;
            document.getElementById('editContactInfo').value = itemData.contactInfo || '';
            document.getElementById('editPrice').value = itemData.price;
            document.getElementById('editCategory').value = itemData.category;
            document.getElementById('editForm').action = `/dashboard/item/${itemData.id}/edit`;
            
            // Handle Existing Images & Deletion Input Construction
            const imageContainer = document.getElementById('editImageContainer');
            imageContainer.innerHTML = '';
            
            if (itemData.images && itemData.images.length > 0) {
                itemData.images.forEach((imgUrl) => {
                    const div = document.createElement('div');
                    div.style = 'position: relative; width: 80px; height: 80px; flex-shrink: 0;';
                    
                    const img = document.createElement('img');
                    img.src = imgUrl;
                    img.style = 'width: 100%; height: 100%; object-fit: cover; border-radius: 4px; border: 1px solid #ccc;';
                    
                    const hiddenInput = document.createElement('input');
                    hiddenInput.type = 'hidden';
                    hiddenInput.name = 'existingImages';
                    hiddenInput.value = imgUrl;
                    
                    const removeBtn = document.createElement('button');
                    removeBtn.innerHTML = '&times;';
                    removeBtn.type = 'button';
                    removeBtn.style = 'position: absolute; top: -5px; right: -5px; background: #FF6B6B; color: white; border: none; border-radius: 50%; width: 20px; height: 20px; cursor: pointer; font-size: 14px; line-height: 1; padding: 0;';
                    removeBtn.onclick = () => div.remove(); 
                    
                    div.appendChild(img);
                    div.appendChild(hiddenInput);
                    div.appendChild(removeBtn);
                    imageContainer.appendChild(div);
                });
            } else {
                imageContainer.innerHTML = '<p style="font-size: 0.8rem; color: #718096; margin: 0;">No existing images.</p>';
            }

            document.getElementById('editModal').style.display = 'flex';
        }
    </script>
</body>
</html>